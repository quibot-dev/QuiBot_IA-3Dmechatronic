OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-realtime"
OPENAI_VOICE="alloy"
OPENAI_LANGUAGE="ca"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
OPENAI_TRANSCRIPTION_LANGUAGE="ca"
OPENAI_TRANSCRIPTION_PROMPT="Conversa amb un robot educatiu anomenat Quibot en català, castellà i anglès."
# Set these two values from the output of: python -m robot_poc --list-devices
# ROBOT_POC_INPUT_DEVICE="2"
# ROBOT_POC_OUTPUT_DEVICE="2"
ROBOT_POC_MAX_OUTPUT_TOKENS="260"
ROBOT_POC_PRINT_USER_TRANSCRIPTS="true"
ROBOT_POC_OUTPUT_GAIN="1.0"
ROBOT_POC_ALLOW_BARGE_IN="false"
ROBOT_POC_SUPPRESS_MIC_DURING_PLAYBACK="true"
ROBOT_POC_VAD_CREATE_RESPONSE="false"
ROBOT_POC_VAD_INTERRUPT_RESPONSE="false"
ROBOT_POC_PLAYBACK_GATE_HOLD_MS="1500"
ROBOT_POC_AUTO_FACE_EVENTS="true"
ROBOT_POC_DUAL_EYE_SERIAL_PORT="/dev/ttyS0"
ROBOT_POC_DUAL_EYE_SERIAL_BAUDRATE="115200"
ROBOT_POC_DUAL_EYE_SERIAL_WRITE_TIMEOUT_S="1.0"
ROBOT_POC_DUAL_EYE_SERIAL_STARTUP_DELAY_S="2.0"
ROBOT_POC_DUAL_EYE_ENDPOINT=""
ROBOT_POC_DUAL_EYE_TIMEOUT_S="1.0"
ROBOT_POC_MOTION_SERIAL_PORT="/dev/ttyACM0"
ROBOT_POC_MOTION_SERIAL_BAUDRATE="115200"
ROBOT_POC_MOTION_SERIAL_WRITE_TIMEOUT_S="1.0"
ROBOT_POC_MOTION_SERIAL_STARTUP_DELAY_S="2.0"
ROBOT_POC_MOTION_TIMEOUT_S="1.0"
ROBOT_POC_AUTO_MOTION_EVENTS="true"
ROBOT_POC_WAKE_WORD_ENABLED="true"
ROBOT_POC_WAKE_WORD_MODEL_PATH="models/vosk-model-small-ca-0.4"
ROBOT_POC_WAKE_WORD_PHRASES="quibot"
ROBOT_POC_WAKE_WORD_ACTIVATION_DELAY_MS="800"
ROBOT_POC_WAKE_ACK_ENABLED="true"
ROBOT_POC_WAKE_ACK_TEXT="Hola! Com et puc ajudar avui?"
ROBOT_POC_SLEEP_WORD_ENABLED="true"
ROBOT_POC_SLEEP_WORD_PHRASES="quibot ves a dormir,ves a dormir quibot,quibot pots anar a dormir,pots anar a dormir quibot,quibot a dormir,a dormir quibot,quibot descansa,descansa quibot,quibot mode repos,mode repos quibot,quibot bona nit,bona nit quibot,quibot adeu,adeu quibot,quibot adios,adios quibot,quibot buenas noches,buenas noches quibot,quibot vete a dormir,vete a dormir quibot,quibot ve a dormir,ve a dormir quibot,quibot modo reposo,modo reposo quibot,quibot go to sleep,go to sleep quibot,quibot sleep,sleep quibot,quibot goodbye,goodbye quibot,quibot good night,good night quibot"
ROBOT_POC_ACTIVE_IDLE_TIMEOUT_S="20"
